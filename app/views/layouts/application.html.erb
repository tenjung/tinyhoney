<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tiny Honey" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-slate-50 font-sans text-slate-900 flex flex-col min-h-screen">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-8">
            <%= link_to root_path, class: "flex items-center gap-2 group" do %>
              <div class="w-10 h-10 bg-yellow-400 rounded-xl flex items-center justify-center shadow-sm group-hover:rotate-12 transition-transform">
                <span class="text-2xl">🐝</span>
              </div>
              <span class="text-xl font-black tracking-tight text-slate-900">티꿀모아<span class="text-yellow-500 text-sm ml-1 italic font-medium">TinyHoney</span></span>
            <% end %>

            <nav class="hidden md:flex items-center gap-6">
              <%= link_to "실시간 핫딜", root_path, class: "text-sm font-semibold hover:text-yellow-500 transition-colors" %>
              <%= link_to "진행 중 이벤트", events_path, class: "text-sm font-semibold hover:text-yellow-500 transition-colors" %>
              <%= link_to "커뮤니티", boards_path, class: "text-sm font-semibold hover:text-yellow-500 transition-colors" %>
            </nav>
          </div>

          <div class="flex items-center gap-4">
            <button class="p-2 text-slate-500 hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
            <% if user_signed_in? %>
              <%= link_to "마이페이지", profile_path, class: "text-sm font-bold text-slate-700 hover:text-slate-900 transition-colors" %>
              <%= button_to "로그아웃", destroy_user_session_path, method: :delete, class: "text-sm font-bold text-red-500 hover:text-red-700 transition-colors" %>
            <% else %>
              <div class="hidden lg:flex items-center gap-2">
                <%= button_to user_google_oauth2_omniauth_authorize_path, data: { turbo: false }, class: "w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-slate-50 transition-colors shadow-sm" do %>
                   <span class="text-xs">G</span>
                <% end %>
                <%#= button_to user_kakao_omniauth_authorize_path, data: { turbo: false }, class: "w-8 h-8 rounded-full bg-[#FEE500] flex items-center justify-center hover:opacity-90 transition-colors shadow-sm" do %>
                   <!-- <span class="text-xs">K</span> -->
                <%# end %>
                <%= button_to user_naver_omniauth_authorize_path, data: { turbo: false }, class: "w-8 h-8 rounded-full bg-[#03C75A] flex items-center justify-center hover:opacity-90 transition-colors shadow-sm text-white" do %>
                   <span class="text-xs">N</span>
                <% end %>
              </div>
              <%= link_to "로그인", new_user_session_path, class: "text-sm font-bold text-slate-700 hover:text-slate-900 transition-colors" %>
              <%= link_to "시작하기", new_user_registration_path, class: "px-5 py-2.5 bg-yellow-400 hover:bg-yellow-500 text-slate-900 text-sm font-bold rounded-full transition-all shadow-sm hover:shadow-md active:scale-95" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <% if notice %>
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-4 container mx-auto" role="alert">
          <p><%= notice %></p>
        </div>
      <% end %>

      <% if alert %>
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4 container mx-auto" role="alert">
          <p><%= alert %></p>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-slate-900 text-slate-400 py-12">
      <div class="container mx-auto px-4 text-center">
        <div class="flex items-center justify-center gap-2 mb-6">
          <div class="w-8 h-8 bg-yellow-400 rounded-lg flex items-center justify-center shadow-sm">
            <span class="text-lg">🐝</span>
          </div>
          <span class="text-lg font-black tracking-tight text-white">티꿀모아</span>
        </div>
        <p class="text-sm mb-4">전국 모든 핫딜을 한자리에 모았다. 티꿀모아 <br> © 2026 TinyHoney Platform. All Rights Reserved.</p>
        <div class="flex justify-center gap-6 text-xs font-semibold uppercase tracking-widest">
          <%= link_to "서비스 약관", "#", class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "개인정보 처리방침", "#", class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "광고 문의", "#", class: "hover:text-yellow-400 transition-colors" %>
        </div>
      </div>
    </footer>
  </body>
</html>
