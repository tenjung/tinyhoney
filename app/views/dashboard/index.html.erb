<%# ── Dashboard / 실시간 핫딜 피드 (컴포넌트 사용) ── %>

<div class="dash-wrap">

  <%# Header Stats %>
  <%= render 'shared/header_stats',
      title_small: 'TinyHoney Live Board',
      title: '실시간 핫딜 모음',
      subtitle: '모든 커뮤니티의 실시간 핫딜을 한눈에 정리해드려요',
      stats: [
        { label: '전체', value: @total_deal_count },
        { label: '결과', value: @filtered_count },
        { label: '최저가', value: @lowest_count, color: 'var(--color-emerald-600)' }
      ] %>

  <%# Search Bar %>
  <%= render 'shared/search_bar',
      action_path: root_path,
      placeholder: '상품명으로 검색',
      filters: [
        { type: :select, name: :source, options: [["전체 출처", nil], ["뽐뿌", "ppomppu"], ["루리웹", "ruliweb"], ["퀘이사존", "quasarzone"], ["어미새", "amisae"], ["클리앙", "clien"], ["아카라이브", "arcalive"]] },
        { type: :select, name: :sort, options: [["최신순", nil], ["가격 낮은순", "price_asc"], ["가격 높은순", "price_desc"]] },
        { type: :checkbox, name: :only_lowest, label: '최저가만 보기' }
      ] %>

  <%# Category Pills %>
  <%= render 'shared/category_pills',
      action_path: root_path,
      param_name: :source,
      categories: [["전체", nil], ["뽐뿌", "ppomppu"], ["루리웹", "ruliweb"], ["퀘이사존", "quasarzone"], ["어미새", "amisae"], ["클리앙", "clien"], ["아카라이브", "arcalive"]],
      extra_params: { q: params[:q], sort: params[:sort], only_lowest: params[:only_lowest] } %>

  <%# Deal List %>
  <% if @recent_deals.any? %>
    <section style="display:flex;flex-direction:column;gap:0.5rem">
      <% @recent_deals.each do |deal| %>
        <%= render 'shared/list_card', item: deal, type: :deal, detail_path: deal_path(deal) %>
      <% end %>
    </section>
  <% else %>
    <%= render 'shared/empty_state',
        icon: '🔍',
        title: '검색 결과가 없습니다',
        message: '조건을 조정하거나 초기화를 눌러 다시 확인해 보세요.',
        buttons: [{ label: '필터 초기화', path: root_path, primary: false }] %>
  <% end %>

</div>
