<%# ── Deal Detail Page ── %>

<div class="dash-wrap">

  <%# ━━ 뒤로가기 버튼 ━━ %>
  <div style="margin-bottom: 1rem;">
    <%= link_to root_path, class: "btn btn-outline" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right:0.25rem"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      목록으로
    <% end %>
  </div>

  <%# ━━ 메인 카드 ━━ %>
  <article class="card-static" style="padding: 2rem;">
    
    <%# 썸네일 이미지 %>
    <% if @deal.thumbnail_url.present? %>
      <div style="width: 100%; max-width: 600px; margin: 0 auto 2rem; border-radius: 1rem; overflow: hidden; background: var(--color-slate-100);">
        <%= image_tag @deal.thumbnail_url, style: "width: 100%; height: auto; display: block;", alt: @deal.title %>
      </div>
    <% end %>

    <%# 배지 %>
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <% if @deal.category.present? %>
        <span class="badge"><%= @deal.category %></span>
      <% end %>
      <% if @deal.respond_to?(:shop_name) && @deal.shop_name.present? %>
        <span class="badge"><%= @deal.shop_name %></span>
      <% end %>
      <span class="badge badge-source">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
        <%= @deal.source %>
      </span>
      <% if @deal.is_lowest? %>
        <span class="badge badge-amber">🐝 허니픽 (역대 최저가)</span>
      <% end %>
    </div>

    <%# 제목 %>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--color-slate-900); margin-bottom: 2rem; line-height: 1.3;">
      <%= @deal.title %>
    </h1>

    <%# 가격 정보 카드 %>
    <div style="background: linear-gradient(135deg, var(--color-slate-50) 0%, var(--color-slate-100) 100%); border-radius: 1rem; padding: 2rem; margin-bottom: 2rem; border: 2px solid var(--color-slate-200);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
        <%# 현재 가격 %>
        <div>
          <p style="font-size: 0.875rem; color: var(--color-slate-500); font-weight: 600; margin-bottom: 0.5rem;">현재 가격</p>
          <% if @deal.price.present? && @deal.price > 0 %>
            <p style="font-size: 2.5rem; font-weight: 900; color: var(--color-rose-600); line-height: 1;">
              <%= number_to_currency(@deal.price, unit: "원", precision: 0, format: "%n%u") %>
            </p>
          <% else %>
            <p style="font-size: 1.25rem; font-weight: 700; color: var(--color-slate-500);">가격 정보 없음</p>
          <% end %>
          
          <%# 배송비 %>
          <% if @deal.respond_to?(:shipping_fee) %>
            <p style="font-size: 0.875rem; color: var(--color-slate-600); margin-top: 0.5rem; font-weight: 600;">
              <%= @deal.shipping_fee.to_i == 0 ? "🚚 배송 무료" : "🚚 배송 #{number_to_currency(@deal.shipping_fee, unit: '원', precision: 0, format: '%n%u')}" %>
            </p>
          <% end %>

          <%# 할인율 %>
          <% if @deal.price_histories.count > 1 %>
            <% discount = @deal.discount_rate %>
            <% if discount > 0 %>
              <div style="margin-top: 1rem;">
                <span class="badge badge-emerald" style="font-size: 1rem; padding: 0.5rem 1rem;">
                  <%= discount %>% 할인 ↓
                </span>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# 구매 버튼 %>
        <div>
          <%= link_to @deal.url, target: "_blank", rel: "noopener", class: "btn btn-primary", style: "background: var(--color-amber-500); border-color: var(--color-amber-500); font-size: 1.125rem; padding: 1rem 2.5rem; font-weight: 700; white-space: nowrap;" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right: 0.5rem;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            구매하러 가기
          <% end %>
        </div>
      </div>
    </div>

    <%# 가격 변동 그래프 %>
    <% if @price_history.present? && @price_history.size > 1 %>
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--color-slate-900); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-amber-500);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          가격 변동 추이
        </h2>
        <div style="background: white; border: 1px solid var(--color-slate-200); border-radius: 0.75rem; padding: 1.5rem;">
          <%= line_chart @price_history, 
              prefix: "₩", 
              thousands: ",", 
              xtitle: "날짜", 
              ytitle: "가격",
              colors: ["#f59e0b"],
              library: { 
                backgroundColor: "#ffffff",
                borderColor: "#e2e8f0",
                pointBackgroundColor: "#f59e0b",
                pointBorderColor: "#fff",
                pointHoverBackgroundColor: "#fff",
                pointHoverBorderColor: "#f59e0b"
              } %>
        </div>
        
        <%# 가격 분석 메시지 %>
        <% if @deal.is_lowest? %>
          <div style="margin-top: 1rem; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 1rem 1.5rem; border-radius: 0.75rem; border: 2px solid #fbbf24; display: flex; align-items: center; gap: 1rem;">
            <div style="font-size: 2rem;">🐝</div>
            <p style="color: #92400e; font-weight: 600; font-size: 0.9375rem;">
              <strong style="font-weight: 800;">역대 최저가</strong>입니다! 지금이 구매 적기예요.
            </p>
          </div>
        <% elsif @deal.price_histories.count > 1 %>
          <% discount = @deal.discount_rate %>
          <% if discount > 10 %>
            <div style="margin-top: 1rem; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); padding: 1rem 1.5rem; border-radius: 0.75rem; border: 2px solid #34d399; display: flex; align-items: center; gap: 1rem;">
              <div style="font-size: 2rem;">📉</div>
              <p style="color: #065f46; font-weight: 600; font-size: 0.9375rem;">
                이전 가격 대비 <strong style="font-weight: 800;"><%= discount %>% 저렴</strong>합니다. 좋은 가격이에요!
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# 상세 정보 %>
    <% if @deal.description.present? %>
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--color-slate-900); margin-bottom: 1rem;">상세 정보</h2>
        <div style="background: white; border: 1px solid var(--color-slate-200); border-radius: 0.75rem; padding: 1.5rem; white-space: pre-wrap; line-height: 1.7; color: var(--color-slate-700); font-size: 0.9375rem;">
<%= @deal.description %>
        </div>
      </div>
    <% end %>

    <%# 메타 정보 %>
    <div style="display: flex; gap: 1rem; padding: 1rem; background: var(--color-slate-50); border-radius: 0.75rem; flex-wrap: wrap;">
      <% if @deal.posted_at.present? %>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-slate-400);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span style="font-size: 0.875rem; color: var(--color-slate-600); font-weight: 500;"><%= time_ago_in_words(@deal.posted_at) %>전 등록</span>
        </div>
      <% end %>
      <% if @deal.created_at.present? %>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-slate-400);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span style="font-size: 0.875rem; color: var(--color-slate-600); font-weight: 500;">수집일: <%= @deal.created_at.strftime("%Y.%m.%d") %></span>
        </div>
      <% end %>
    </div>

  </article>

</div>
