<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← 목록으로", root_path, class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden mb-8 border border-gray-100">
    <div class="p-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-semibold text-sm"><%= @deal.source %></span>
        <% if @deal.is_lowest %>
          <span class="px-3 py-1 rounded-full bg-red-100 text-red-800 font-bold text-sm">역대 최저가</span>
        <% end %>
      </div>
      
      <h1 class="text-3xl font-extrabold mb-6 leading-tight"><%= @deal.title %></h1>
      
      <div class="flex justify-between items-end mb-8 pb-8 border-b border-gray-100">
        <div>
          <p class="text-gray-500 text-sm mb-1">현재 가격</p>
          <p class="text-5xl font-black text-red-600">
            <%= number_to_currency(@deal.price, unit: "원", precision: 0, format: "%n%u") %>
          </p>
        </div>
        <div class="text-right">
          <%= link_to "구매하러 가기", @deal.url, class: "inline-block px-8 py-4 bg-yellow-400 hover:bg-yellow-500 text-black font-bold rounded-xl transition-all scale-100 hover:scale-105 shadow-lg", target: "_blank" %>
        </div>
      </div>

      <div class="py-4">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          가격 변동 지수
        </h2>
        
        <div class="h-64 mb-4">
          <%= line_chart @price_history, prefix: "₩", thousands: ",", xtitle: "날짜", ytitle: "가격" %>
        </div>
        
        <div class="bg-yellow-50 p-4 rounded-xl border border-yellow-100 flex items-center gap-3">
          <div class="text-2xl">🐝</div>
          <p class="text-yellow-800 font-medium">
            현재 가격이 최저가 대비 <span class="font-bold underline">15% 저렴</span>합니다. 지금이 살 때!
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
