<% content_for :title, "이벤트 관리" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
    <%= form_with url: admin_events_path, method: :get, class: "flex w-full md:w-auto" do |f| %>
      <div class="relative w-full md:w-80">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q], placeholder: "이벤트명, 주최사 검색...", class: "pl-10 block w-full rounded-md border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" %>
      </div>
    <% end %>

    <%= link_to new_admin_event_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      이벤트 등록
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">이벤트 정보</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">기간/발표</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">유형</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">상태</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Edit</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @events.each do |event| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <% if event.thumbnail_url.present? %>
                    <%= image_tag event.thumbnail_url, class: "h-10 w-10 rounded-full object-cover" %>
                  <% else %>
                    <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center text-xs">🎁</div>
                  <% end %>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-slate-900 truncate max-w-xs"><%= event.title %></div>
                  <div class="text-sm text-slate-500"><%= event.organizer %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-slate-900"><%= event.start_date&.strftime("%m.%d") %> ~ <%= event.end_date&.strftime("%m.%d") %></div>
              <div class="text-xs text-slate-500">발표: <%= event.announcement_date&.strftime("%m.%d") || "-" %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800">
                <%= event.platform_type %>
              </span>
              <div class="text-xs text-slate-500 mt-1"><%= event.entry_type %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if event.end_date && event.end_date < Date.today %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-200 text-slate-600">종료</span>
              <% elsif event.end_date && event.end_date <= Date.today + 3.days %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-rose-100 text-rose-800">D-<%= (event.end_date - Date.today).to_i %></span>
              <% else %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-emerald-100 text-emerald-800">진행중</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "수정", edit_admin_event_path(event), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= link_to "삭제", admin_event_path(event), data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?" }, class: "text-rose-600 hover:text-rose-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="p-4 border-t border-slate-200">
    <%= paginate @events %>
  </div>
</div>
