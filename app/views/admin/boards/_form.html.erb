<% content_for :title, @board.new_record? ? "게시판 생성" : "게시판 수정" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-2xl mx-auto">
  <%= form_with(model: [:admin, @board], local: true, class: "space-y-6") do |f| %>
    <% if @board.errors.any? %>
      <div class="bg-rose-50 p-4 rounded-md border border-rose-200">
        <h3 class="text-sm font-medium text-rose-800"><%= pluralize(@board.errors.count, "error") %> prohibited this board from being saved:</h3>
        <ul class="mt-2 list-disc pl-5 text-sm text-rose-700">
          <% @board.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "게시판 이름", class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "예: 자유게시판" %>
    </div>

    <div>
      <%= f.label :slug, "Slug (URL 경로)", class: "block text-sm font-medium text-slate-700" %>
      <div class="mt-1 flex rounded-md shadow-sm">
        <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-slate-300 bg-slate-50 text-slate-500 sm:text-sm">
          /boards/
        </span>
        <%= f.text_field :slug, class: "flex-1 min-w-0 block w-full px-3 py-2 rounded-none rounded-r-md border-slate-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "free" %>
      </div>
      <p class="mt-2 text-sm text-slate-500">영문 소문자, 숫자, 하이픈(-)만 사용 가능합니다.</p>
    </div>

    <div>
      <%= f.label :description, "설명", class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :description, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "게시판에 대한 간단한 설명" %>
    </div>

    <div class="flex justify-end pt-5">
      <%= link_to "취소", admin_boards_path, class: "bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3" %>
      <%= f.submit @board.new_record? ? "생성하기" : "수정하기", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>
</div>
