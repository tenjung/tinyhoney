<% content_for :title, "게시판 설정" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
  <div class="p-4 border-b border-slate-100 flex justify-between items-center">
    <h2 class="text-lg font-bold text-slate-800">게시판 목록</h2>
    <%= link_to new_admin_board_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      게시판 생성
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">이름</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Slug (URL)</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">설명</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">게시글 수</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Edit</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @boards.each do |board| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-bold text-slate-900"><%= board.name %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800">
                <%= board.slug %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
              <%= board.description %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
              <%= board.posts.count %>개
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "수정", edit_admin_board_path(board.slug), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= link_to "삭제", admin_board_path(board.slug), data: { turbo_method: :delete, turbo_confirm: "게시판을 삭제하면 포함된 모든 게시글도 삭제됩니다. 정말 삭제하시겠습니까?" }, class: "text-rose-600 hover:text-rose-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
