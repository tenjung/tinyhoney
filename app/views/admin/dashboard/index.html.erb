<% content_for :title, "대시보드" %>

<%# ━━ 통계 카드 ━━ %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-slate-500 text-sm font-bold uppercase">전체 회원</h3>
      <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-black text-slate-800"><%= number_with_delimiter @total_users %></div>
    <div class="text-sm text-slate-500 mt-1">
      <span class="text-emerald-600 font-bold">▲ <%= User.where("created_at >= ?", 1.week.ago).count %></span> 이번 주 신규
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-slate-500 text-sm font-bold uppercase">전체 핫딜</h3>
      <div class="p-2 bg-amber-50 rounded-lg text-amber-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-black text-slate-800"><%= number_with_delimiter @total_deals %></div>
    <div class="text-sm text-slate-500 mt-1">
      <span class="text-emerald-600 font-bold">▲ <%= Deal.where("created_at >= ?", 1.day.ago).count %></span> 오늘 등록
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-slate-500 text-sm font-bold uppercase">진행중 이벤트</h3>
      <div class="p-2 bg-rose-50 rounded-lg text-rose-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-black text-slate-800"><%= number_with_delimiter Event.where("end_date >= ?", Date.today).count %></div>
    <div class="text-sm text-slate-500 mt-1">
      전체 <%= number_with_delimiter @total_events %>개 중
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-slate-500 text-sm font-bold uppercase">전체 게시글</h3>
      <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.76-3H7a4 4 0 00-4 4v2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l-4 4l6 6l4 -16l-18 7l4 2l2 6l3 -4" style="display:none;"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-black text-slate-800"><%= number_with_delimiter @total_posts %></div>
    <div class="text-sm text-slate-500 mt-1">
      <span class="text-emerald-600 font-bold">▲ <%= Post.where("created_at >= ?", 1.day.ago).count %></span> 오늘 작성
    </div>
  </div>
</div>

<%# ━━ 차트 ━━ %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <h3 class="text-lg font-bold text-slate-800 mb-4">최근 30일 가입자 추이</h3>
    <%= line_chart User.group_by_day(:created_at, last: 30).count, colors: ["#6366f1"], height: "200px" %>
  </div>
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <h3 class="text-lg font-bold text-slate-800 mb-4">카테고리별 핫딜 분포</h3>
    <%= pie_chart Deal.group(:category).count, donut: true, height: "200px" %>
  </div>
</div>

<%# ━━ 최근 활동 ━━ %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%# 최근 가입 회원 %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex justify-between items-center">
      <h3 class="font-bold text-slate-800">최근 가입 회원</h3>
      <%= link_to "전체보기", admin_users_path, class: "text-sm text-indigo-600 hover:underline" %>
    </div>
    <div class="divide-y divide-slate-100">
      <% @recent_users.each do |user| %>
        <div class="p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs font-bold">
              <%= user.email.first.upcase %>
            </div>
            <div>
              <div class="font-medium text-slate-900 text-sm"><%= user.email %></div>
              <div class="text-xs text-slate-500"><%= time_ago_in_words(user.created_at) %> 전</div>
            </div>
          </div>
          <span class="text-xs text-slate-400"><%= user.provider || "Email" %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# 최근 등록 핫딜 %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex justify-between items-center">
      <h3 class="font-bold text-slate-800">최근 등록 핫딜</h3>
      <%= link_to "전체보기", admin_deals_path, class: "text-sm text-amber-600 hover:underline" %>
    </div>
    <div class="divide-y divide-slate-100">
      <% @recent_deals.each do |deal| %>
        <div class="p-4 flex items-center justify-between">
          <div class="flex items-center gap-3 overflow-hidden">
            <% if deal.thumbnail_url.present? %>
              <%= image_tag deal.thumbnail_url, class: "w-10 h-10 rounded object-cover border border-slate-100" %>
            <% else %>
              <div class="w-10 h-10 rounded bg-slate-100 flex items-center justify-center text-xs">📦</div>
            <% end %>
            <div class="min-w-0">
              <div class="font-medium text-slate-900 text-sm truncate"><%= deal.title %></div>
              <div class="text-xs text-slate-500"><%= deal.shop_name %> ㆍ <%= number_to_currency(deal.price, unit: "원", precision: 0) %></div>
            </div>
          </div>
          <span class="text-xs text-slate-400 whitespace-nowrap"><%= time_ago_in_words(deal.created_at) %> 전</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
