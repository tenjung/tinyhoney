<div class="container mx-auto px-4 py-12">
  <div class="mb-12 flex items-center justify-between">
    <div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">유저 관리</h1>
      <p class="text-slate-500 font-medium">가입된 회원 및 권한을 관리합니다.</p>
    </div>
    <%= link_to "대시보드로 돌아가기", admin_root_path, class: "text-slate-400 hover:text-slate-900 font-bold transition-colors" %>
  </div>

  <div class="bg-white rounded-[40px] border border-slate-100 shadow-sm overflow-hidden">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100">
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">이름</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">이메일</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">권한</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest w-32">가입일</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% User.all.order(created_at: :desc).each do |user| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-8 py-6">
              <span class="text-slate-900 font-bold"><%= user.name.presence || "G" %></span>
            </td>
            <td class="px-8 py-6">
              <span class="text-slate-500 font-medium"><%= user.email %></span>
            </td>
            <td class="px-8 py-6">
              <% if user.admin? %>
                <span class="px-2 py-0.5 bg-yellow-400 text-yellow-900 text-[10px] font-black rounded-full uppercase">Admin</span>
              <% else %>
                <span class="px-2 py-0.5 bg-slate-100 text-slate-400 text-[10px] font-black rounded-full uppercase">User</span>
              <% end %>
            </td>
            <td class="px-8 py-6">
              <span class="text-xs font-bold text-slate-400"><%= user.created_at.strftime("%Y.%m.%d") %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
