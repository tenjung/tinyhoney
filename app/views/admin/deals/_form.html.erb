<% content_for :title, @deal.new_record? ? "핫딜 등록" : "핫딜 수정" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-3xl mx-auto">
  <%= form_with(model: [:admin, @deal], local: true, class: "space-y-6") do |f| %>
    <% if @deal.errors.any? %>
      <div class="bg-rose-50 p-4 rounded-md border border-rose-200">
        <h3 class="text-sm font-medium text-rose-800"><%= pluralize(@deal.errors.count, "error") %> prohibited this deal from being saved:</h3>
        <ul class="mt-2 list-disc pl-5 text-sm text-rose-700">
          <% @deal.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="col-span-2">
        <%= f.label :title, "제목", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div class="col-span-2">
        <%= f.label :url, "링크 URL", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :url, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :shop_name, "쇼핑몰명", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :shop_name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :category, "카테고리", class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :category, ["디지털", "가전", "식품", "생활용품", "의류", "뷰티", "스포츠", "게임", "가구", "반려동물", "키즈", "통신", "기타"], { prompt: "선택하세요" }, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :price, "가격", class: "block text-sm font-medium text-slate-700" %>
        <%= f.number_field :price, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :shipping_fee, "배송비", class: "block text-sm font-medium text-slate-700" %>
        <%= f.number_field :shipping_fee, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div class="col-span-2">
        <%= f.label :thumbnail_url, "썸네일 URL", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :thumbnail_url, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div class="col-span-2">
        <%= f.label :description, "상세 설명", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>

      <div class="col-span-2">
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= f.check_box :is_lowest, class: "focus:ring-amber-500 h-4 w-4 text-amber-600 border-slate-300 rounded" %>
          </div>
          <div class="ml-3 text-sm">
            <%= f.label :is_lowest, "역대 최저가 (허니픽)", class: "font-medium text-slate-700" %>
            <p class="text-slate-500">체크 시 '허니픽' 배지가 표시됩니다.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end pt-5">
      <%= link_to "취소", admin_deals_path, class: "bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 mr-3" %>
      <%= f.submit @deal.new_record? ? "등록하기" : "수정하기", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-amber-600 hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500" %>
    </div>
  <% end %>
</div>
