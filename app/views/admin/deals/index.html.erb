<% content_for :title, "핫딜 관리" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
    <%= form_with url: admin_deals_path, method: :get, class: "flex w-full md:w-auto" do |f| %>
      <div class="relative w-full md:w-80">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q], placeholder: "핫딜 제목, 쇼핑몰 검색...", class: "pl-10 block w-full rounded-md border-slate-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 sm:text-sm" %>
      </div>
    <% end %>

    <%= link_to new_admin_deal_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-amber-600 hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      핫딜 등록
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">상품정보</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">가격/몰</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">카테고리</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">등록일</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Edit</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @deals.each do |deal| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <% if deal.thumbnail_url.present? %>
                    <%= image_tag deal.thumbnail_url, class: "h-10 w-10 rounded-full object-cover" %>
                  <% else %>
                    <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center text-xs">📦</div>
                  <% end %>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-slate-900 truncate max-w-xs"><%= deal.title %></div>
                  <div class="text-sm text-slate-500"><%= deal.url %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-slate-900"><%= number_to_currency(deal.price, unit: "원", precision: 0) %></div>
              <div class="text-sm text-slate-500"><%= deal.shop_name %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800">
                <%= deal.category %>
              </span>
              <% if deal.is_lowest? %>
                <span class="ml-1 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-amber-100 text-amber-800">최저가</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
              <%= deal.created_at.strftime("%Y-%m-%d") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "수정", edit_admin_deal_path(deal), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= link_to "삭제", admin_deal_path(deal), data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?" }, class: "text-rose-600 hover:text-rose-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="p-4 border-t border-slate-200">
    <%= paginate @deals %>
  </div>
</div>
