<div class="container mx-auto px-4 py-12">
  <div class="mb-12 flex items-center justify-between">
    <div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">딜 관리</h1>
      <p class="text-slate-500 font-medium">수집된 상품 데이터를 관리합니다.</p>
    </div>
    <%= link_to "대시보드로 돌아가기", admin_root_path, class: "text-slate-400 hover:text-slate-900 font-bold transition-colors" %>
  </div>

  <div class="bg-white rounded-[40px] border border-slate-100 shadow-sm overflow-hidden">
    <table class="w-full text-left">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100">
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">상품명</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">출처</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">가격</th>
          <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest w-24">작업</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% Deal.all.order(created_at: :desc).limit(50).each do |deal| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-8 py-6">
              <span class="text-slate-900 font-bold block truncate max-w-md"><%= deal.title %></span>
            </td>
            <td class="px-8 py-6">
              <span class="text-xs font-black bg-slate-100 px-2 py-1 rounded-full text-slate-500"><%= deal.source %></span>
            </td>
            <td class="px-8 py-6">
              <span class="text-sm font-black text-slate-900"><%= number_to_currency(deal.price, unit: "원", format: "%n%u") %></span>
            </td>
            <td class="px-8 py-6">
              <%= button_to "삭제", admin_deal_path(deal), method: :delete, data: { confirm: "정말 삭제하시겠습니까?" }, class: "text-red-500 hover:text-red-700 text-xs font-black" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
