<% content_for :title, "게시글 관리" %>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
    <%= form_with url: admin_posts_path, method: :get, class: "flex w-full md:w-auto" do |f| %>
      <div class="relative w-full md:w-80">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q], placeholder: "제목, 내용 검색...", class: "pl-10 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">게시글 정보</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">작성자</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">게시판</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">작성일</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Edit</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @posts.each do |post| %>
          <tr>
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-slate-900 truncate max-w-sm"><%= link_to post.title, post_path(post), target: "_blank", class: "hover:underline" %></div>
              <div class="text-xs text-slate-500 truncate max-w-sm"><%= post.content.to_plain_text.truncate(50) if post.content.respond_to?(:to_plain_text) %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-slate-900"><%= post.user.name.presence || post.user.email.split('@').first %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800">
                <%= post.board.name %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
              <%= post.created_at.strftime("%Y-%m-%d") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "삭제", admin_post_path(post), data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?" }, class: "text-rose-600 hover:text-rose-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="p-4 border-t border-slate-200">
    <%= paginate @posts %>
  </div>
</div>
