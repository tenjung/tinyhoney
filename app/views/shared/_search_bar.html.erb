<%# ── Shared Component: Search Bar ── %>
<%# 사용법: render 'shared/search_bar', 
    action_path:, 
    placeholder:, 
    filters: [{type: :select/:checkbox, name:, options:, selected:}],
    buttons: [{label:, path:, style:}] %>

<section class="card-static search-bar">
  <%= form_with url: action_path, method: :get do |f| %>
    <div class="search-row">
      <div class="search-field-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5-5m1-4a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <%= f.text_field :q, value: params[:q], placeholder: placeholder, class: "input input-search" %>
      </div>
      <%= f.submit "검색", class: "btn btn-primary" %>
      <%= link_to "초기화", action_path, class: "btn btn-outline" %>
      <% if local_assigns[:buttons].present? %>
        <% buttons.each do |btn| %>
          <%= link_to btn[:label], btn[:path], class: "btn btn-primary", style: btn[:style] %>
        <% end %>
      <% end %>
    </div>

    <% if local_assigns[:filters].present? %>
      <% advanced_open = filters.any? { |f| params[f[:name]].present? } %>
      <details <%= "open" if advanced_open %> class="adv-filter">
        <summary>고급 필터</summary>
        <div class="adv-filter-grid">
          <% filters.each do |filter| %>
            <% if filter[:type] == :select %>
              <%= f.select filter[:name], filter[:options], { selected: params[filter[:name]] }, { class: "input" } %>
            <% elsif filter[:type] == :checkbox %>
              <label class="input" style="cursor:pointer">
                <%= f.check_box filter[:name], { checked: params[filter[:name]] == "1", style: "width:1rem;height:1rem;accent-color:var(--color-amber-500)" }, "1", "0" %>
                <span style="font-size:0.8125rem;color:var(--color-slate-600)"><%= filter[:label] %></span>
              </label>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</section>
