<%# ── Shared Component: List Card (Deal/Event) ── %>
<%# 사용법: render 'shared/list_card', item:, type: :deal/:event, detail_path: %>

<%= link_to detail_path, class: "card deal-card", style: "text-decoration: none; color: inherit; display: flex; cursor: pointer;" do %>
  <%# Thumbnail %>
  <div class="deal-thumb">
    <% thumbnail_url = item.thumbnail_url.to_s %>
    <% if thumbnail_url.match?(%r{\Ahttps?://}i) || thumbnail_url.start_with?("//", "/") %>
      <%= image_tag thumbnail_url, alt: item.title, loading: "lazy", skip_pipeline: true %>
    <% else %>
      <div class="deal-thumb-empty"><%= type == :event ? "🎁" : "📦" %></div>
    <% end %>
  </div>

  <%# Info %>
  <div class="deal-info">
    <%# Tags %>
    <div class="deal-tags">
      <% if type == :deal %>
        <%# Deal 배지 %>
        <% if item.category.present? %>
          <span class="badge"><%= item.category %></span>
        <% end %>
        <% if item.respond_to?(:shop_name) && item.shop_name.present? %>
          <span class="badge"><%= item.shop_name %></span>
        <% end %>
        <span class="badge badge-source">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
          <%= item.source %>
        </span>
        <% if item.is_lowest? %>
          <span class="badge badge-amber">🐝 허니픽</span>
        <% end %>
      <% else %>
        <%# Event 배지 %>
        <% if item.platform_type.present? %>
          <span class="badge"><%= item.platform_type %></span>
        <% end %>
        <% if item.organizer.present? %>
          <span class="badge"><%= item.organizer %></span>
        <% end %>
        <% if item.end_date.present? %>
          <% days_left = (item.end_date - Date.today).to_i %>
          <% if days_left < 0 %>
            <span class="badge" style="border-color: var(--color-slate-300); background: var(--color-slate-100); color: var(--color-slate-500); font-weight: 600;">
              종료
            </span>
          <% elsif days_left >= 0 && days_left <= 3 %>
            <span class="badge" style="border-color: var(--color-rose-500); background: var(--color-rose-50); color: var(--color-rose-700); font-weight: 700;">
              ⏰ D-<%= days_left %>
            </span>
          <% elsif days_left >= 0 %>
            <span class="badge badge-source">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              진행중
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Title %>
    <h2 class="deal-title" style="color: var(--color-slate-900);">
      <%= item.title %>
    </h2>

    <%# Meta %>
    <div class="deal-meta">
      <% if type == :deal %>
        <%# Deal 메타 %>
        <% if item.price.present? && item.price > 0 %>
          <span class="deal-price"><%= number_to_currency(item.price, unit: "원", precision: 0, format: "%n%u") %></span>
        <% end %>
        <% if item.respond_to?(:shipping_fee) %>
          <span class="deal-shipping"><%= item.shipping_fee.to_i == 0 ? "배송 무료" : "배송 #{number_to_currency(item.shipping_fee, unit: '원', precision: 0, format: '%n%u')}" %></span>
        <% end %>
        <% if item.price_histories.count > 1 %>
          <% discount = item.discount_rate %>
          <% if discount > 0 %>
            <span class="badge badge-emerald"><%= discount %>% ↓</span>
          <% end %>
        <% end %>
        <% if item.posted_at.present? %>
          <span class="deal-time"><%= time_ago_in_words(item.posted_at) %>전</span>
        <% end %>
      <% else %>
        <%# Event 메타 %>
        <% if item.start_date.present? && item.end_date.present? %>
          <span class="deal-shipping">
            📅 <%= item.start_date.strftime("%m.%d") %> ~ <%= item.end_date.strftime("%m.%d") %>
          </span>
        <% end %>
        <% if item.winner_count.present? && item.winner_count > 0 %>
          <span class="deal-time">🎁 총 <%= item.winner_count %>명</span>
        <% end %>
        <% if item.entry_type.present? %>
          <span class="deal-shipping"><%= item.entry_type %></span>
        <% end %>
        <% if item.prize_tags.present? %>
          <% prizes = item.prizes.first(2) %>
          <% prizes.each do |prize| %>
            <span class="badge badge-amber"><%= prize %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
