<%# ── Events / 진행 중 이벤트 (컴포넌트 사용 + 탭) ── %>

<div class="dash-wrap">

  <%# Header Stats %>
  <%= render 'shared/header_stats',
      title_small: 'TinyHoney Event Board',
      title: @current_tab == 'ongoing' ? '진행 중 이벤트' : '마감된 이벤트',
      subtitle: '핫딜만큼 강력한 각종 이벤트 정보를 모아보세요',
      stats: [
        { label: '전체', value: @total_count },
        { label: '결과', value: @filtered_count },
        { label: '진행중', value: @ongoing_count, color: 'var(--color-emerald-600)' },
        { label: '마감임박', value: @ending_soon_count, color: 'var(--color-rose-600)' }
      ] %>

  <%# ━━ 탭 ━━ %>
  <section class="card-static" style="padding: 1rem 1.5rem;">
    <div style="display: flex; gap: 0.5rem; border-bottom: 2px solid var(--color-slate-100);">
      <%= link_to events_path(tab: 'ongoing', q: params[:q], platform_type: params[:platform_type], entry_type: params[:entry_type], sort: params[:sort]),
          class: "pill #{@current_tab == 'ongoing' ? 'pill-active' : ''}",
          style: "border-radius: 0.5rem 0.5rem 0 0; border-bottom: none; #{@current_tab == 'ongoing' ? 'border-bottom: 3px solid var(--color-amber-500);' : ''}" do %>
        진행중 <%= @ongoing_count %>
      <% end %>
      <%= link_to events_path(tab: 'closed', q: params[:q], platform_type: params[:platform_type], entry_type: params[:entry_type], sort: params[:sort]),
          class: "pill #{@current_tab == 'closed' ? 'pill-active' : ''}",
          style: "border-radius: 0.5rem 0.5rem 0 0; border-bottom: none; #{@current_tab == 'closed' ? 'border-bottom: 3px solid var(--color-amber-500);' : ''}" do %>
        마감 <%= @closed_count %>
      <% end %>
    </div>
  </section>

  <%# Search Bar %>
  <%= render 'shared/search_bar',
      action_path: events_path,
      placeholder: '이벤트명, 주최사로 검색',
      filters: [
        { type: :select, name: :platform_type, options: [["전체 카테고리", nil], ["통신사", "telecom"], ["가전", "appliance"], ["게임", "game"], ["식품", "food"], ["의류", "fashion"], ["디지털", "digital"], ["가구", "furniture"], ["뷰티", "beauty"]] },
        { type: :select, name: :entry_type, options: [["전체 응모형태", nil], ["작문/댓글", "작문/댓글"], ["선착순", "선착순"], ["구매", "구매"], ["가입", "가입"], ["자동참여", "자동참여"]] },
        { type: :select, name: :sort, options: [["최신순", nil], ["당첨자 많은순", "winner_desc"], ["마감 임박순", "ending_soon"]] },
        (@current_tab == 'ongoing' ? { type: :select, name: :status, options: [["전체 상태", nil], ["마감임박만", "ending_soon"]] } : nil)
      ].compact,
      buttons: [
        { label: '이벤트 등록', path: new_event_path, style: 'background: var(--color-amber-500); border-color: var(--color-amber-500);' }
      ] %>

  <%# Category Pills %>
  <%= render 'shared/category_pills',
      action_path: events_path,
      param_name: :platform_type,
      categories: [["전체", nil], ["통신사", "telecom"], ["가전", "appliance"], ["게임", "game"], ["식품", "food"], ["의류", "fashion"], ["디지털", "digital"], ["가구", "furniture"], ["뷰티", "beauty"]],
      extra_params: { tab: @current_tab, q: params[:q], entry_type: params[:entry_type], sort: params[:sort], status: params[:status] } %>

  <%# Event List %>
  <% if @events.any? %>
    <section style="display:flex;flex-direction:column;gap:0.5rem">
      <% @events.each do |event| %>
        <%= render 'shared/list_card', item: event, type: :event, detail_path: event_path(event) %>
      <% end %>
    </section>
  <% else %>
    <%= render 'shared/empty_state',
        icon: '🎈',
        title: @current_tab == 'ongoing' ? '진행 중인 이벤트가 없습니다' : '마감된 이벤트가 없습니다',
        message: '조건을 조정하거나 초기화를 눌러 다시 확인해 보세요.',
        buttons: [
          { label: '필터 초기화', path: events_path(tab: @current_tab), primary: false },
          (@current_tab == 'ongoing' ? { label: '이벤트 등록하기', path: new_event_path, primary: true, style: 'background: var(--color-amber-500); border-color: var(--color-amber-500);' } : nil)
        ].compact %>
  <% end %>

</div>
