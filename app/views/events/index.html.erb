<div class="container mx-auto px-4 py-12">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">진행 중인 이벤트</h1>
      <p class="text-slate-500 font-medium">핫딜만큼 강력한 각종 이벤트 정보를 모아보세요.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "전체", events_path, class: "px-5 py-2.5 #{params[:platform_type].blank? ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200'} text-sm font-bold rounded-full transition-all" %>
      <%= link_to "웹 전용", events_path(platform_type: "web"), class: "px-5 py-2.5 #{params[:platform_type] == 'web' ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200'} text-sm font-bold rounded-full transition-all" %>
      <%= link_to "앱 전용", events_path(platform_type: "app"), class: "px-5 py-2.5 #{params[:platform_type] == 'app' ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200'} text-sm font-bold rounded-full transition-all" %>
      <div class="w-px h-8 bg-slate-200 mx-2"></div>
      <%= link_to "이벤트 등록하기", new_event_path, class: "px-6 py-3 bg-yellow-400 hover:bg-yellow-500 text-slate-900 font-black rounded-2xl transition-all shadow-lg shadow-yellow-400/20 active:scale-95" %>
    </div>
  </div>

  <% if @events.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @events.each do |event| %>
        <div class="group bg-white rounded-3xl border border-slate-100 overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="aspect-video bg-slate-50 relative overflow-hidden">
            <% if event.thumbnail_url.present? %>
              <%= image_tag event.thumbnail_url, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-5xl">🎁</div>
            <% end %>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-white/90 backdrop-blur shadow-sm rounded-full text-[10px] font-black uppercase tracking-widest text-slate-900">
                <%= event.platform_type %>
              </span>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-xl font-black text-slate-900 mb-4 line-clamp-2 min-h-[3.5rem] group-hover:text-yellow-600 transition-colors">
              <%= link_to event.title, event.url, target: "_blank" %>
            </h3>
            <p class="text-slate-500 text-sm font-medium mb-6 line-clamp-2">
              <%= event.description.presence || "상세 정보가 없습니다." %>
            </p>
            <div class="flex items-center justify-between pt-6 border-t border-slate-50">
              <span class="text-xs font-bold text-slate-400">
                <%= event.created_at.strftime("%Y.%m.%d") %> 등록
              </span>
              <%= link_to event.url, target: "_blank", class: "flex items-center gap-2 text-sm font-black text-slate-900 hover:text-yellow-600 transition-colors" do %>
                이벤트 확인
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-[40px] p-20 text-center border-2 border-dashed border-slate-200">
      <div class="text-8xl mb-8">🎈</div>
      <h3 class="text-2xl font-black text-slate-900 mb-4">등록된 이벤트가 없습니다.</h3>
      <p class="text-slate-500 mb-8 max-w-sm mx-auto">첫 번째 이벤트를 직접 등록해 보세요!</p>
      <%= link_to "이벤트 등록하기", new_event_path, class: "px-8 py-4 bg-yellow-400 hover:bg-yellow-500 text-slate-900 font-black rounded-3xl transition-all shadow-lg shadow-yellow-400/20 active:scale-95 inline-block" %>
    </div>
  <% end %>
</div>
