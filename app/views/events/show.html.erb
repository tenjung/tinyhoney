<%# ── Event Detail Page ── %>

<div class="dash-wrap">

  <%# ━━ 뒤로가기 버튼 ━━ %>
  <div style="margin-bottom: 1rem;">
    <%= link_to events_path, class: "btn btn-outline" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right:0.25rem"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      목록으로
    <% end %>
  </div>

  <%# ━━ 메인 카드 ━━ %>
  <article class="card-static" style="padding: 2rem;">
    
    <%# 제목 %>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--color-slate-900); margin-bottom: 2rem; line-height: 1.3;">
      <%= @event.title %>
    </h1>

    <%# 2단 레이아웃: 이미지(좌) + 메타테이블(우) %>
    <div style="display: flex; gap: 2rem; margin-bottom: 2rem; flex-wrap: wrap;">
      
      <%# 왼쪽: 썸네일 이미지 %>
      <div style="flex: 0 0 auto; width: 100%; max-width: 400px;">
        <% if @event.thumbnail_url.present? %>
          <div style="width: 100%; aspect-ratio: 1; border-radius: 1rem; overflow: hidden; background: var(--color-slate-100);">
            <%= image_tag @event.thumbnail_url, style: "width: 100%; height: 100%; object-cover;", alt: @event.title, skip_pipeline: true %>
          </div>
        <% else %>
          <div style="width: 100%; aspect-ratio: 1; border-radius: 1rem; background: var(--color-slate-100); display: flex; align-items: center; justify-content: center; font-size: 5rem;">
            🎁
          </div>
        <% end %>
      </div>

      <%# 오른쪽: 메타 정보 테이블 %>
      <div style="flex: 1; min-width: 300px;">
        <div style="background: var(--color-slate-50); border-radius: 0.75rem; padding: 1.5rem; height: 100%;">
          <table style="width: 100%; border-collapse: collapse;">
            <tbody>
              <% if @event.organizer.present? %>
                <tr style="border-bottom: 1px solid var(--color-slate-200);">
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500); width: 120px;">주최사</td>
                  <td style="padding: 0.75rem 1rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-slate-900);"><%= @event.organizer %></td>
                </tr>
              <% end %>

              <% if @event.start_date.present? && @event.end_date.present? %>
                <tr style="border-bottom: 1px solid var(--color-slate-200);">
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500);">응모기간</td>
                  <td style="padding: 0.75rem 1rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-slate-900);">
                    <%= @event.start_date.strftime("%Y.%m.%d") %> ~ <%= @event.end_date.strftime("%Y.%m.%d") %>
                    <% days_left = (@event.end_date - Date.today).to_i %>
                    <% if days_left >= 0 && days_left <= 3 %>
                      <span class="badge" style="margin-left: 0.5rem; border-color: var(--color-rose-500); background: var(--color-rose-50); color: var(--color-rose-700);">
                        ⏰ D-<%= days_left %>
                      </span>
                    <% elsif days_left >= 0 %>
                      <span class="badge" style="margin-left: 0.5rem; border-color: var(--color-emerald-500); background: var(--color-emerald-50); color: var(--color-emerald-700);">
                        진행중
                      </span>
                    <% else %>
                      <span class="badge" style="margin-left: 0.5rem; border-color: var(--color-slate-300); background: var(--color-slate-100); color: var(--color-slate-500);">
                        종료
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <% if @event.entry_type.present? %>
                <tr style="border-bottom: 1px solid var(--color-slate-200);">
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500);">응모형태</td>
                  <td style="padding: 0.75rem 1rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-slate-900);"><%= @event.entry_type %></td>
                </tr>
              <% end %>

              <% if @event.announcement_date.present? %>
                <tr style="border-bottom: 1px solid var(--color-slate-200);">
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500);">당첨자 발표일</td>
                  <td style="padding: 0.75rem 1rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-slate-900);"><%= @event.announcement_date.strftime("%Y.%m.%d") %></td>
                </tr>
              <% end %>

              <% if @event.winner_count.present? && @event.winner_count > 0 %>
                <tr style="border-bottom: 1px solid var(--color-slate-200);">
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500);">총 당첨자수</td>
                  <td style="padding: 0.75rem 1rem; font-size: 0.9375rem; font-weight: 700; color: var(--color-emerald-600);"><%= @event.winner_count %>명</td>
                </tr>
              <% end %>

              <% if @event.prize_tags.present? %>
                <tr>
                  <td style="padding: 0.75rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-slate-500); vertical-align: top;">경품태그</td>
                  <td style="padding: 0.75rem 1rem;">
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                      <% @event.prizes.each do |prize| %>
                        <span class="badge badge-amber" style="font-size: 0.8125rem; padding: 0.25rem 0.625rem;">
                          <%= prize %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# 이벤트 참여 버튼 %>
    <div style="display: flex; gap: 1rem; justify-content: center; margin-bottom: 2rem;">
      <%= link_to @event.url, target: "_blank", rel: "noopener", class: "btn btn-primary", style: "background: var(--color-amber-500); border-color: var(--color-amber-500); font-size: 1rem; padding: 0.875rem 2.5rem; font-weight: 700;" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right: 0.5rem;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        이벤트 참여하기
      <% end %>
    </div>

    <%# 상세 설명 %>
    <% if @event.description.present? %>
      <div>
        <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--color-slate-900); margin-bottom: 1rem;">이벤트 상세</h2>
        <div style="background: white; border: 1px solid var(--color-slate-200); border-radius: 0.75rem; padding: 1.5rem; white-space: pre-wrap; line-height: 1.7; color: var(--color-slate-700); font-size: 0.9375rem;">
<%= @event.description %>
        </div>
      </div>
    <% end %>

  </article>

</div>
