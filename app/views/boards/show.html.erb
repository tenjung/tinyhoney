<div class="container mx-auto px-4 py-12">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div>
      <div class="flex items-center gap-2 text-sm font-bold text-slate-400 mb-4 uppercase tracking-widest">
        <%= link_to "커뮤니티", boards_path, class: "hover:text-slate-900 transition-colors" %>
        <span class="text-slate-200">/</span>
        <span class="text-slate-900"><%= @board.name %></span>
      </div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tight"><%= @board.name %></h1>
    </div>
    <%= link_to "글쓰기", new_board_post_path(@board.slug), class: "px-6 py-3 bg-slate-900 text-white font-black rounded-2xl hover:bg-slate-800 transition-all shadow-lg shadow-slate-900/10 active:scale-95 text-center" %>
  </div>

  <div class="bg-white rounded-[40px] shadow-sm border border-slate-100 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100">
            <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest">제목</th>
            <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest w-24">작성자</th>
            <th class="px-8 py-4 text-xs font-black text-slate-400 uppercase tracking-widest w-24">날짜</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @posts.any? %>
            <% @posts.each do |post| %>
              <tr class="hover:bg-yellow-50/30 transition-colors group">
                <td class="px-8 py-6">
                  <%= link_to board_post_path(@board.slug, post), class: "block" do %>
                    <span class="text-slate-900 font-bold group-hover:text-yellow-600 transition-colors">
                      <%= post.title %>
                    </span>
                    <% if post.comments.any? %>
                      <span class="ml-2 text-xs font-black text-yellow-500 bg-yellow-100 px-2 py-0.5 rounded-full">
                        <%= post.comments.count %>
                      </span>
                    <% end %>
                  <% end %>
                </td>
                <td class="px-8 py-6">
                  <span class="text-sm font-medium text-slate-500"><%= post.user.name.presence || "G" %></span>
                </td>
                <td class="px-8 py-6">
                  <span class="text-xs font-bold text-slate-400 whitespace-nowrap"><%= post.created_at.strftime("%m.%d") %></span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="px-8 py-20 text-center text-slate-400 font-medium">
                작성된 게시글이 없습니다. 첫 글의 주인공이 되세요!
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
