<div class="min-h-[calc(100vh-64px)] flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-2xl shadow-xl border border-gray-100">
    <!-- Header -->
    <div class="text-center">
      <h2 class="mt-2 text-3xl font-extrabold text-gray-900 tracking-tight">
        돌아오셨군요! 👋
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        티꿀모아와 함께 더 스마트한 쇼핑을 즐겨보세요.
      </p>
    </div>

    <!-- Social Login Buttons -->
    <div class="mt-8 space-y-3">
      <%- if devise_mapping.omniauthable? %>
        <%- resource_class.omniauth_providers.each do |provider| %>
          <% if provider == :google_oauth2 %>
            <%= button_to omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full flex justify-center items-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors duration-200" do %>
              <svg class="h-5 w-5 mr-3" viewBox="0 0 24 24">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              Google로 계속하기
            <% end %>
          <% elsif provider == :naver %>
            <%= button_to omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full flex justify-center items-center py-2.5 px-4 rounded-lg shadow-sm bg-[#03C75A] text-sm font-medium text-white hover:bg-[#02b351] transition-colors duration-200" do %>
              <span class="font-black mr-3 text-lg">N</span>
              Naver로 계속하기
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="relative mt-8">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-gray-200"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-2 bg-white text-gray-500">또는 이메일로 로그인</span>
      </div>
    </div>

    <!-- Login Form -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <%= f.label :email, class: "sr-only" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "이메일 주소", class: "appearance-none rounded-none relative block w-full px-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-lg focus:outline-none focus:ring-yellow-500 focus:border-yellow-500 focus:z-10 sm:text-sm transition-colors" %>
        </div>
        <div>
          <%= f.label :password, class: "sr-only" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "비밀번호", class: "appearance-none rounded-none relative block w-full px-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-lg focus:outline-none focus:ring-yellow-500 focus:border-yellow-500 focus:z-10 sm:text-sm transition-colors" %>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-yellow-500 focus:ring-yellow-400 border-gray-300 rounded cursor-pointer" %>
            <%= f.label :remember_me, "로그인 유지", class: "ml-2 block text-sm text-gray-900 cursor-pointer select-none" %>
          </div>
        <% end %>

        <div class="text-sm">
          <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to "비밀번호를 잊으셨나요?", new_password_path(resource_name), class: "font-medium text-yellow-600 hover:text-yellow-500" %>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.submit "로그인", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-lg text-white bg-yellow-500 hover:bg-yellow-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 transition-all shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>
    <% end %>

    <!-- Footer -->
    <div class="text-center mt-4">
      <p class="text-sm text-gray-600">
        아직 계정이 없으신가요?
        <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
          <%= link_to "회원가입 하기", new_registration_path(resource_name), class: "font-medium text-yellow-600 hover:text-yellow-500 ml-1 underline underline-offset-2" %>
        <% end %>
      </p>
    </div>
  </div>
</div>
