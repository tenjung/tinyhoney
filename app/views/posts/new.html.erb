<div class="container mx-auto px-4 py-12 max-w-3xl">
  <div class="bg-white rounded-[40px] shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-8 md:p-12 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-slate-900 mb-2">글쓰기</h1>
        <p class="text-slate-500 font-medium"><%= @board.name %>에 새로운 게시글을 작성합니다.</p>
      </div>
      <%= link_to board_path(@board.slug), class: "p-4 bg-slate-50 text-slate-400 hover:text-slate-900 rounded-3xl transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      <% end %>
    </div>

    <%= form_with model: [@board, @post], url: board_posts_path(@board.slug), class: "p-8 md:p-12 space-y-8" do |f| %>
      <% if @post.errors.any? %>
        <div class="p-4 bg-red-50 text-red-700 rounded-2xl text-sm font-bold">
          <%= @post.errors.full_messages.first %>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :title, "제목", class: "block text-xs font-black text-slate-400 uppercase tracking-widest" %>
        <%= f.text_field :title, class: "w-full p-4 bg-slate-50 rounded-2xl border-2 border-transparent focus:border-yellow-400 focus:bg-white transition-all outline-none font-bold placeholder:text-slate-300", placeholder: "제목을 입력하세요" %>
      </div>

      <div class="space-y-2">
        <%= f.label :content, "내용", class: "block text-xs font-black text-slate-400 uppercase tracking-widest" %>
        <%= f.text_area :content, rows: 12, class: "w-full p-4 bg-slate-50 rounded-2xl border-2 border-transparent focus:border-yellow-400 focus:bg-white transition-all outline-none font-medium placeholder:text-slate-300", placeholder: "정보를 나누고 소통해 보세요!" %>
      </div>

      <div class="pt-6">
        <%= f.submit "작성 완료", class: "w-full py-5 bg-slate-900 text-white font-black rounded-3xl transition-all shadow-xl shadow-slate-900/10 active:scale-95" %>
      </div>
    <% end %>
  </div>
</div>
